{
    "name": "loshmis/vanguard",
    "description": "Advanced PHP Login and User Management",
    "keywords": ["advanced", "secure", "login", "user management", "authentication", "authorization", "register"],
    "type": "project",
    "repositories": [],
    "require": {
        "php": "^8.4",
        "anlutro/l4-settings": "^1.4",
        "bacon/bacon-qr-code": "^3.0",
        "barryvdh/laravel-debugbar": "^3.14",
        "geoip2/geoip2": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image-laravel": "^1.3",
        "jenssegers/agent": "^2.6",
        "jeremykenedy/laravel-roles": "^11.0",
        "laracasts/presenter": "^0.2.6",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "league/fractal": "^0.20",
        "pragmarx/google2fa-laravel": "^2.2",
        "predis/predis": "^2.2",
        "spatie/db-dumper": "^3.6",
        "stripe/stripe-php": "^19.2",
        "tanmuhittin/laravel-google-translate": "^2.4",
        "tightenco/ziggy": "^2.6",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VanguardLTE\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "app/Games/",
            "app/Models/User.php",
            "app/Jobs/CoinpaymentListener.php",
            "app/Http/Middleware/ValidateSignature.php",
            "app/Http/Middleware/PreventRequestsDuringMaintenance.php",
            "app/Http/Middleware/TrustHosts.php",
            "app/Http/Controllers/Web/Backend/Lchat.php",
            "app/Http/Controllers/Web/Backend/ShopsController_original.php"
        ],
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
